{
  "name": "holdem-flicker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fonts": "bash scripts/fetch-fonts.sh",
    "audit:layout": "node scripts/layout-audit.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
